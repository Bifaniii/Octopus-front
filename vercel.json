{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/clinica-pet/browser",
   "rewrites": [
    { "source": "/api/:caminho*", "destination": "/api/proxy?caminho=:caminho*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
