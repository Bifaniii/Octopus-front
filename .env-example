# Copie para .env e preencha. O .env não é versionado.
#
# Endereço de cada microsserviço. Quem lê estas variáveis é a função api/[...path].js, que repassa as
# chamadas /api do front para o backend, e o proxy do `ng serve` em desenvolvimento.
#
# Em produção, cadastre todas em Vercel > Settings > Environment Variables. Nenhum endereço de
# backend entra no repositório: o vercel.json não interpola variáveis, então um rewrite estático
# obrigaria a versionar os IPs.

# Sem valor, o `ng serve` usa a porta local de cada módulo (8080 a 8086).
API_DEFAULT_URL=
API_BAIAS_URL=
API_MEDICACOES_URL=
API_INTERNACOES_URL=
API_PRESCRICOES_URL=
API_DOSES_URL=
API_RELATORIOS_URL=
